        "lucide-react": "1.37.0",
        "next": "16.3.3",
        "pg": "8.23.0",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "zod": "4.5.2"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.11",
        "@tailwindcss/postcss": "4.3.3",
        "@types/node": "26.4.0",
        "@types/pg": "8.23.1",
        "@types/react": "19.2.18",
