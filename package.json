        "lint:fix": "biome lint --fix .",
        "check": "biome check .",
        "check:fix": "biome check --write .",
        "fix:all": "pnpm run format && pnpm run lint:fix && pnpm run check:fix",
        "format": "biome format --write .",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "migrate:legacy": "node --env-file-if-exists=.env scripts/migrate-legacy.mjs"
    },
    "dependencies": {
        "chart.js": "4.5.1",
        "clsx": "2.1.1",
        "dayjs": "1.11.23",
