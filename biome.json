{
    "$schema": "https://biomejs.dev/schemas/latest/schema.json",

    "files": {
        "includes": ["**", "!**/.next", "!**/node_modules", "!**/dist", "!**/build", "!**/next-env.d.ts"],
        "ignoreUnknown": true
    },

    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },

    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "semicolons": "always",
            "arrowParentheses": "always",
            "bracketSpacing": true,
            "trailingCommas": "all",
            "attributePosition": "multiline"
        }
    },

    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "correctness": {
                "noUnusedFunctionParameters": "error",
                "noUnusedVariables": "error",
                "noUnusedImports": {
                    "level": "error",
                    "fix": "safe"
                }
            },
            "style": {
                "useImportType": "warn",
                "useBlockStatements": {
                    "level": "error",
                    "fix": "safe"
                },
                "noEnum": "error"
            },
            "suspicious": {
                "noConsole": {
                    "level": "error",
                    "options": {
                        "allow": ["error", "info", "warn"]
                    }
                },
                "noDebugger": "error",
                "useIterableCallbackReturn": "off"
            },
            "nursery": {
                "useSortedClasses": {
                    "level": "error",
                    "fix": "safe"
                }
            }
        }
    },

    "css": {
        "parser": {
            "tailwindDirectives": true
        }
    },

    "assist": {
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    }
}
